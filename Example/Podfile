platform :ios, '18.0'

target 'CoinflowFraudExample' do
  use_frameworks!

  pod 'CoinflowFraud', :path => '..'
end

# Some signal SDK pods declare iOS 14.0, below current Xcode's minimum of 15.0.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '18.0'
    end
  end
end
